# .env.example
#
# Copy this file to `.env` and fill in real values before running the bot.
# Never commit the real `.env` file — it should stay in .gitignore.

# --- Telegram Notifier -------------------------------------------------------
# Bot token from @BotFather. Leave both TELEGRAM_* vars empty/unset to run
# the bot with Telegram notifications disabled (safe no-op mode).
TELEGRAM_BOT_TOKEN=8888217336:AAFwHqZpb17qPIA-clqkdNUdhoCNb8zrb0Y
# Numeric chat ID (or channel ID) that should receive trade alerts and
# respond to /start, /status, /help. Use @userinfobot to find your chat ID.
TELEGRAM_CHAT_ID=5925206681
# --- Logging -----------------------------------------------------------------
# Log verbosity for the bot's structured logging. One of: DEBUG, INFO,
# WARNING, ERROR, CRITICAL. Use DEBUG for local troubleshooting, INFO for
# normal production operation.
LOG_LEVEL=INFO

# --- dYdX v4 Credentials (reserved for live trading) --------------------------
# Not required for paper trading; PaperExchange simulates execution locally.
# Populate these when/if the bot is extended to place real orders on dYdX v4.

# dYdX v4 wallet mnemonic (24-word seed phrase) used to derive the trading
# account's signing key. NEVER commit a real mnemonic to version control.
DYDX_V4_MNEMONIC=monitor cactus aerobic valley clown drift cruel ribbon smooth cram inject mother

# dYdX v4 REST/indexer + gRPC node endpoints. Leave blank to use defaults
# once live-trading support is implemented.
DYDX_V4_LIVE_TRADING_ENABLED=false
DYDX_V4_INDEXER_URL=https://indexer.dydx.trade
DYDX_V4_NODE_URL=dydx-grpc.publicnode.com:443
DYDX_V4_CHAIN_ID=dydx-mainnet-1
STRATEGY_MIN_ATR_PCT=0.01
# dYdX v4 subaccount number to trade against (defaults to 0 if unset).
DYDX_V4_SUBACCOUNT_NUMBER=0
CANDLE_RESOLUTION=1HOUR
STRATEGY_TYPE=trend_pullback
STRATEGY_EMA_TREND=200
STRATEGY_EMA_PULLBACK=20
PAPER_TRADING=true
PAPER_BALANCE=15
TICKERS=ETH-USD,SOL-USD,NEAR-USD
